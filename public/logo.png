<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 120" width="320" height="120">
  <defs>
    <!-- گرادیان نئونی و درخشان نارنجی لیدرا -->
    <linearGradient id="neonOrange" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#FF5722" />
      <stop offset="50%" stop-color="#F9704E" />
      <stop offset="100%" stop-color="#FFAB91" />
    </linearGradient>
    
    <!-- گرادیان تیره برای پس‌زمینه نماد -->
    <linearGradient id="darkMetal" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1E1E22" />
      <stop offset="100%" stop-color="#0B0B0D" />
    </linearGradient>

    <!-- سایه ملایم زیر آیکون -->
    <filter id="premiumGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="6" stdDeviation="5" flood-color="#F9704E" flood-opacity="0.25"/>
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#000000" flood-opacity="0.6"/>
    </filter>
  </defs>

  <!-- ۱. نشان تجاری (آیکون ۳ بعدی) با کادر و حاشیه مشخص که روی پس‌زمینه تیره گم نشود -->
  <g transform="translate(205, 10)" filter="url(#premiumGlow)">
    <rect x="0" y="0" width="100" height="100" rx="30" fill="url(#darkMetal)" stroke="#F9704E" stroke-width="2" opacity="0.95"/>
    <path d="M35 30 L55 55 L35 80 Z" fill="#2E2E33" opacity="0.9" />
    <path d="M50 20 L54 20 L54 80 L50 80 Z" fill="url(#neonOrange)" opacity="0.4" />
    <path d="M48 25 L75 52 L48 80 L58 80 L85 52 L58 25 Z" fill="url(#neonOrange)" />
    <circle cx="52" cy="20" r="3" fill="#FFFFFF" />
  </g>
  
  <!-- ۲. نام لیدرا - متن کاملاً واضح -->
  <g transform="translate(15, 68)">
    <text font-family="system-ui, -apple-system, sans-serif" font-weight="900" font-size="42" fill="#FFFFFF" letter-spacing="2">
      LIDARA<tspan fill="url(#neonOrange)">.</tspan>
    </text>
  </g>
</svg>
